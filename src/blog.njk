---
layout: layouts/base.njk
title: Blog
description: Notes on design, craft, and the things I build.
permalink: /blog/
---
<section class="section section--top">
  <div class="wrap narrow">
    <header class="page-head">
      <p class="hero-kicker"><span class="muted">$</span> cat ./blog/*.md</p>
      <h1 class="page-title">Blog</h1>
      <p class="page-intro">
        Notes on design, craft, and whatever I'm currently figuring out.
      </p>
    </header>

    <ul class="blog-list">
      {% for post in collections.posts %}
      <li class="blog-list-item">
        <a href="{{ post.url }}">
          <p class="blog-list-meta">
            <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
            <span class="muted">·</span> {{ post.templateContent | readingTime }} read
          </p>
          <h2 class="blog-list-title">{{ post.data.title }}</h2>
          {% if post.data.summary %}<p class="blog-list-summary">{{ post.data.summary }}</p>{% endif %}
        </a>
      </li>
      {% else %}
      <li class="muted">No posts yet — check back soon.</li>
      {% endfor %}
    </ul>
  </div>
</section>
